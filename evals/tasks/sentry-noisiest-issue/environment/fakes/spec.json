{
 "api": {
  "args": "<endpoint>",
  "desc": "Make an authenticated API request",
  "flags": {
   "method": {
    "short": "X",
    "value": true,
    "multi": false,
    "help": "The HTTP method for the request",
    "default": "GET"
   },
   "data": {
    "short": "d",
    "value": true,
    "multi": false,
    "help": "Inline JSON body for the request (like curl -d)",
    "default": null
   },
   "field": {
    "short": "F",
    "value": true,
    "multi": true,
    "help": "Add a typed parameter (key=value, key[sub]=value, key[]=value)",
    "default": null
   },
   "raw-field": {
    "short": "f",
    "value": true,
    "multi": true,
    "help": "Add a string parameter without JSON parsing",
    "default": null
   },
   "header": {
    "short": "H",
    "value": true,
    "multi": true,
    "help": "Add a HTTP request header in key:value format",
    "default": null
   },
   "input": {
    "short": null,
    "value": true,
    "multi": false,
    "help": "The file to use as body for the HTTP request (use \"-\" to read from standard input)",
    "default": null
   },
   "silent": {
    "short": null,
    "value": false,
    "multi": false,
    "help": "Do not print the response body",
    "default": null
   },
   "verbose": {
    "short": null,
    "value": false,
    "multi": false,
    "help": "Include full HTTP request and response in the output",
    "default": null
   },
   "dry-run": {
    "short": "n",
    "value": false,
    "multi": false,
    "help": "Show the resolved request without sending it",
    "default": null
   }
  }
 },
